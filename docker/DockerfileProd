FROM amazoncorretto:21
ENV TZ="Asia/Seoul"

ARG SENTRY_AUTH_TOKEN
ENV SENTRY_AUTH_TOKEN=${SENTRY_AUTH_TOKEN}

RUN mkdir -p /service/sseudam
COPY sseudam-core/core-api/build/libs/core-api-0.1.0.jar /service/sseudam/core-api.jar

EXPOSE 8080

CMD java \
    -Dspring.profiles.active=prod \
    -DSENTRY_AUTH_TOKEN=${SENTRY_AUTH_TOKEN} \
    -jar /service/sseudam/core-api.jar
